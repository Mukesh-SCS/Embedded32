{
  "name": "embedded32",
  "version": "1.0.0",
  "private": true,
  "description": "Embedded32 Platform - Monorepo workspace",
  "type": "module",
  "workspaces": [
    "embedded32-core",
    "embedded32-can",
    "embedded32-j1939",
    "embedded32-ethernet",
    "embedded32-bridge",
    "embedded32-sim",
    "embedded32-tools",
    "embedded32-supervisor",
    "embedded32-cli",
    "embedded32-dashboard",
    "embedded32-sdk-js",
    "embedded32-sdk-c",
    "embedded32-sdk-python"
  ],
  "scripts": {
    "build": "lerna run build",
    "test": "lerna run test",
    "typecheck": "lerna run typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "lerna run clean --ignore @embedded32/sdk-c --ignore @embedded32/sdk-python",
    "bootstrap": "lerna bootstrap",
    "publish-packages": "lerna publish --yes",
    "audit:packages": "node scripts/audit-packages.mjs",
    "test:package-install": "node scripts/smoke-install-packages.mjs",
    "test:labs": "node scripts/verify-labs.mjs",
    "test:examples": "node scripts/verify-examples.mjs",
    "test:docs": "node scripts/verify-docs.mjs",
    "test:coverage": "node scripts/coverage-report.mjs",
    "seed:issues": "node scripts/seed-contributor-issues.mjs",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run build && npm run audit:packages && npm run test:package-install && npm run test:labs && npm run test:examples && npm run test:docs",
    "docs:api": "typedoc --options typedoc.json"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9.0.0",
    "globals": "^15.0.0",
    "jest": "^29.0.0",
    "lerna": "^8.0.0",
    "prettier": "^3.0.0",
    "typedoc": "^0.27.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^4.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Mukesh-SCS/Embedded32.git"
  },
  "author": "Mukesh Mani Tripathi",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
