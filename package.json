{
  "name": "embedded32",
  "version": "1.0.0",
  "private": true,
  "description": "Embedded32 Platform - Monorepo workspace",
  "type": "module",
  "workspaces": [
    "embedded32-core",
    "embedded32-can",
    "embedded32-j1939",
    "embedded32-ethernet",
    "embedded32-bridge",
    "embedded32-sim",
    "embedded32-tools",
    "embedded32-supervisor",
    "embedded32-cli",
    "embedded32-dashboard",
    "embedded32-sdk-js",
    "embedded32-sdk-c",
    "embedded32-sdk-python",
    "apps/site",
    "apps/demo"
  ],
  "scripts": {
    "build": "lerna run build",
    "test": "lerna run test",
    "typecheck": "lerna run typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "lerna run clean --ignore @embedded32/sdk-c --ignore @embedded32/sdk-python",
    "bootstrap": "lerna bootstrap",
    "publish-packages": "lerna publish --yes",
    "release:dry-run": "node scripts/release-dry-run.mjs",
    "audit:packages": "node scripts/audit-packages.mjs",
    "test:package-install": "node scripts/smoke-install-packages.mjs",
    "test:labs": "node scripts/verify-labs.mjs && node --test apps/site/tests/security.test.mjs",
    "test:examples": "node scripts/verify-examples.mjs",
    "test:docs": "node scripts/verify-docs.mjs",
    "test:docs-status": "node scripts/verify-documentation-status.mjs",
    "test:citation": "node scripts/verify-citation.mjs && node --test scripts/tests/citation-security.test.mjs",
    "evidence:collect": "node scripts/collect-evidence.mjs",
    "test:evidence": "node scripts/verify-evidence.mjs",
    "validate:upgrade": "node scripts/validate-upgrade.mjs",
    "test:coverage": "node scripts/coverage-report.mjs",
    "test:e2e:pages": "node scripts/prepare-e2e-pages.mjs",
    "test:e2e": "npm run test:e2e:pages && playwright test",
    "test:e2e:headed": "npm run test:e2e:pages && playwright test --headed",
    "verify:pages": "node scripts/verify-pages-build.mjs",
    "seed:issues": "node scripts/seed-contributor-issues.mjs",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run build && npm run audit:packages && npm run test:package-install && npm run test:labs && npm run test:examples && npm run test:docs && npm run test:docs-status && npm run test:citation && npm run test:evidence && npm run validate:upgrade",
    "predocs:api": "npm run build",
    "docs:api": "typedoc --options typedoc.json"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.54.1",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.10",
    "globals": "^17.7.0",
    "jest": "^29.0.0",
    "lerna": "^9.0.7",
    "prettier": "^3.0.0",
    "serve": "^14.2.4",
    "typedoc": "^0.28.19",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.0.0",
    "vite": "^8.2.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Mukesh-SCS/Embedded32.git"
  },
  "author": "Mukesh Mani Tripathi",
  "license": "MIT",
  "dependencies": {
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "engines": {
    "node": ">=20.9.0",
    "npm": ">=9.0.0"
  }
}
