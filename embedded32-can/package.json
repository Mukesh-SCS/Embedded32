{
  "name": "@embedded32/can",
  "version": "1.0.1",
  "description": "CAN bus abstraction for Embedded32 with mock, virtual, and SocketCAN drivers",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "clean": "node ../scripts/clean-dist.mjs",
    "prepack": "node ../scripts/copy-license.mjs && npm run build",
    "dev": "tsc -w -p tsconfig.json",
    "test": "node --experimental-vm-modules ../node_modules/jest/bin/jest.js",
    "test:coverage": "node --experimental-vm-modules ../node_modules/jest/bin/jest.js --coverage --coverageReporters=json-summary --coverageReporters=text"
  },
  "keywords": [
    "embedded-systems",
    "can-bus",
    "socketcan",
    "simulation",
    "typescript",
    "education",
    "embedded32"
  ],
  "author": "Mukesh Mani Tripathi",
  "license": "MIT",
  "devDependencies": {
    "@types/jest": "^29.0.0",
    "@types/node": "^20.0.0",
    "jest": "^29.0.0",
    "ts-jest": "^29.4.12",
    "typescript": "~5.8.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Mukesh-SCS/Embedded32.git",
    "directory": "embedded32-can"
  },
  "homepage": "https://github.com/Mukesh-SCS/Embedded32/tree/main/embedded32-can",
  "bugs": {
    "url": "https://github.com/Mukesh-SCS/Embedded32/issues"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "sideEffects": false
}
