{
  "name": "@embedded32/ethernet",
  "version": "1.0.1",
  "description": "Ethernet transport layer for Embedded32: UDP, TCP, MQTT, and NanoProto serialization",
  "type": "commonjs",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "clean": "node ../scripts/clean-dist.mjs",
    "prepack": "node ../scripts/copy-license.mjs && npm run build",
    "test": "jest",
    "dev": "tsc --watch"
  },
  "keywords": [
    "mqtt",
    "ethernet",
    "can-bus",
    "typescript",
    "education",
    "embedded32"
  ],
  "author": "Mukesh Mani Tripathi",
  "license": "MIT",
  "dependencies": {
    "@embedded32/core": "^1.0.1",
    "mqtt": "^5.15.1"
  },
  "devDependencies": {
    "@types/jest": "^29.0.0",
    "@types/node": "^26.2.0",
    "jest": "^29.0.0",
    "typescript": "~5.8.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Mukesh-SCS/Embedded32.git",
    "directory": "embedded32-ethernet"
  },
  "homepage": "https://github.com/Mukesh-SCS/Embedded32/tree/main/embedded32-ethernet",
  "bugs": {
    "url": "https://github.com/Mukesh-SCS/Embedded32/issues"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "sideEffects": false
}
