{
  "name": "@embedded32/bridge",
  "version": "1.0.0",
  "description": "CAN to Ethernet and MQTT bridging with J1939-aware routing rules",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "clean": "node ../scripts/clean-dist.mjs",
    "prepack": "node ../scripts/copy-license.mjs && npm run build",
    "test": "jest",
    "dev": "tsc --watch"
  },
  "keywords": [
    "bridge",
    "mqtt",
    "can-bus",
    "j1939",
    "typescript",
    "education",
    "embedded32"
  ],
  "author": "Mukesh Mani Tripathi",
  "license": "MIT",
  "dependencies": {
    "@embedded32/core": "1.0.0",
    "@embedded32/can": "1.0.0",
    "@embedded32/j1939": "1.0.0",
    "@embedded32/ethernet": "1.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^6.0.3",
    "jest": "^30.4.2",
    "@types/jest": "^30.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Mukesh-SCS/Embedded32.git",
    "directory": "embedded32-bridge"
  },
  "homepage": "https://github.com/Mukesh-SCS/Embedded32/tree/main/embedded32-bridge",
  "bugs": {
    "url": "https://github.com/Mukesh-SCS/Embedded32/issues"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "sideEffects": false
}
