{
  "name": "@embedded32/core",
  "version": "1.0.0",
  "description": "Lightweight embedded runtime for Embedded32: scheduler, messaging, and module registry",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "clean": "node ../scripts/clean-dist.mjs",
    "prepack": "node ../scripts/copy-license.mjs && npm run build",
    "dev": "tsc -w -p tsconfig.json",
    "test": "jest"
  },
  "keywords": [
    "embedded-systems",
    "ecu",
    "scheduler",
    "typescript",
    "education",
    "embedded32"
  ],
  "author": "Mukesh Mani Tripathi",
  "license": "MIT",
  "dependencies": {
    "@embedded32/can": "1.0.0"
  },
  "devDependencies": {
    "@types/jest": "^29.0.0",
    "@types/node": "^20.0.0",
    "@types/onoff": "^4.1.0",
    "jest": "^29.0.0",
    "ts-jest": "^29.4.6",
    "typescript": "~5.8.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Mukesh-SCS/Embedded32.git",
    "directory": "embedded32-core"
  },
  "homepage": "https://github.com/Mukesh-SCS/Embedded32/tree/main/embedded32-core",
  "bugs": {
    "url": "https://github.com/Mukesh-SCS/Embedded32/issues"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "sideEffects": false,
  "optionalDependencies": {
    "onoff": "^6.0.3"
  }
}
