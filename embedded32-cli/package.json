{
  "name": "@embedded32/cli",
  "version": "1.0.0",
  "description": "Command-line interface for launching and managing the Embedded32 runtime",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "commonjs",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "embedded32": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "prepack": "node ../scripts/copy-license.mjs && npm run build",
    "watch": "tsc --watch",
    "test": "jest"
  },
  "dependencies": {
    "@embedded32/can": "1.0.0",
    "@embedded32/core": "1.0.0",
    "@embedded32/j1939": "1.0.0",
    "@embedded32/supervisor": "1.0.0",
    "@embedded32/bridge": "1.0.0",
    "@embedded32/ethernet": "1.0.0",
    "chalk": "^5.3.0",
    "commander": "^11.0.0",
    "ws": "^8.18.3",
    "yaml": "^2.3.0"
  },
  "devDependencies": {
    "@types/jest": "^29.0.0",
    "@types/node": "^20.0.0",
    "jest": "^29.0.0",
    "ts-jest": "^29.4.6",
    "typescript": "^5.0.0"
  },
  "author": "Mukesh Mani Tripathi",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Mukesh-SCS/Embedded32.git",
    "directory": "embedded32-cli"
  },
  "homepage": "https://github.com/Mukesh-SCS/Embedded32/tree/main/embedded32-cli",
  "bugs": {
    "url": "https://github.com/Mukesh-SCS/Embedded32/issues"
  },
  "keywords": [
    "embedded-systems",
    "can-bus",
    "ecu",
    "typescript",
    "education",
    "embedded32"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "sideEffects": false
}
