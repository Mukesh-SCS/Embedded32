{
  "name": "@embedded32/sim",
  "version": "1.0.0",
  "description": "Vehicle and multi-ECU simulation for Embedded32 learning labs",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "vehicle-profiles",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "clean": "node ../scripts/clean-dist.mjs",
    "prepack": "node ../scripts/copy-license.mjs && npm run build",
    "dev": "tsc -w -p tsconfig.json",
    "test": "npx jest --passWithNoTests",
    "test:acceptance": "npx jest tests/phase2-acceptance.test.ts"
  },
  "dependencies": {
    "@embedded32/can": "1.0.0",
    "@embedded32/core": "1.0.0",
    "@embedded32/j1939": "1.0.0"
  },
  "devDependencies": {
    "@types/jest": "^29.0.0",
    "@types/node": "^20.0.0",
    "jest": "^29.0.0",
    "ts-jest": "^29.4.11",
    "typescript": "^6.0.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Mukesh-SCS/Embedded32.git",
    "directory": "embedded32-sim"
  },
  "homepage": "https://github.com/Mukesh-SCS/Embedded32/tree/main/embedded32-sim",
  "bugs": {
    "url": "https://github.com/Mukesh-SCS/Embedded32/issues"
  },
  "keywords": [
    "ecu",
    "simulation",
    "sae-j1939",
    "can-bus",
    "education",
    "typescript",
    "embedded32"
  ],
  "author": "Mukesh Mani Tripathi",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "sideEffects": false
}
