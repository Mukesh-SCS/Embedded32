{
  "name": "@embedded32/j1939",
  "version": "1.0.1",
  "description": "TypeScript SAE J1939 stack for learning and simulation (PGN, SPN, diagnostics, transport subset)",
  "keywords": [
    "sae-j1939",
    "j1939",
    "can-bus",
    "ecu",
    "automotive",
    "simulation",
    "typescript",
    "education",
    "diagnostics",
    "embedded32"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "clean": "node ../scripts/clean-dist.mjs",
    "prepack": "node ../scripts/copy-license.mjs && npm run build",
    "dev": "tsc -w -p tsconfig.json",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "tsc --noEmit",
    "example:parse": "ts-node examples/basic-parse.ts",
    "example:monitor": "ts-node examples/monitor-can.ts",
    "example:sim": "ts-node examples/engine-sim.ts"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Mukesh-SCS/Embedded32.git",
    "directory": "embedded32-j1939"
  },
  "author": "Mukesh Mani Tripathi",
  "license": "MIT",
  "dependencies": {
    "@embedded32/can": "^1.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "jest": "^29.0.0",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.0",
    "typescript": "~5.8.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "homepage": "https://github.com/Mukesh-SCS/Embedded32/tree/main/embedded32-j1939",
  "bugs": {
    "url": "https://github.com/Mukesh-SCS/Embedded32/issues"
  },
  "sideEffects": false
}
