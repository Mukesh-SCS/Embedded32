{
  "name": "@embedded32/supervisor",
  "version": "1.0.1",
  "description": "Runtime supervisor and module lifecycle manager for Embedded32",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "commonjs",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "clean": "node ../scripts/clean-dist.mjs",
    "prepack": "node ../scripts/copy-license.mjs && npm run build",
    "watch": "tsc --watch",
    "test": "jest",
    "test:watch": "jest --watch"
  },
  "dependencies": {
    "@embedded32/bridge": "^1.0.1",
    "@embedded32/can": "^1.0.1",
    "@embedded32/core": "^1.0.1",
    "@embedded32/ethernet": "^1.0.1",
    "@embedded32/j1939": "^1.0.1",
    "yaml": "^2.3.0"
  },
  "devDependencies": {
    "@types/jest": "^29.0.0",
    "@types/node": "^20.0.0",
    "jest": "^29.0.0",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.0",
    "typescript": "~5.8.3"
  },
  "author": "Mukesh Mani Tripathi",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Mukesh-SCS/Embedded32.git",
    "directory": "embedded32-supervisor"
  },
  "homepage": "https://github.com/Mukesh-SCS/Embedded32/tree/main/embedded32-supervisor",
  "bugs": {
    "url": "https://github.com/Mukesh-SCS/Embedded32/issues"
  },
  "keywords": [
    "embedded-systems",
    "ecu",
    "typescript",
    "education",
    "embedded32"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "sideEffects": false
}
